{
  "manifest_version": 3,
  "name": "Asana Color Coder",
  "version": "2.0",
  "description": "Color codes Asana board cards by swim lane. Auto-updates from GitHub.",
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://app.asana.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://app.asana.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Asana Color Coder"
  },
  "icons": {
    "128": "icon.png"
  }
}
